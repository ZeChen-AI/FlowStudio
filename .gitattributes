# Normalize text files and use LF
* text=auto eol=lf

# Windows command scripts normally use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.7z binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
